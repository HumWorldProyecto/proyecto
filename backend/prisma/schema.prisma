generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Continent {
  AFRICA
  ASIA
  EUROPE
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
}

model RssSource {
  id        String     @id @default(uuid())
  url       String     @unique
  continent Continent?
  countryCode String?  @db.VarChar(2)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  channelId String?
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  news News[]

  @@map("rss_sources")
}

model Channel {
  id String @id @default(uuid())
  name String @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources RssSource[]
  @@map("channels")
}

model NewsRetentionPolicy {
  id String @id @default("global")
  retentionDays Int?
  updatedAt DateTime @updatedAt
  @@map("news_retention_policy")
}

model CaptureConfig {
  id                        String   @id @default("global")
  capturePeriodicityMinutes Int?
  updatedAt                 DateTime @updatedAt

  @@map("capture_config")
}

model News {
  id                      String              @id @default(uuid())
  sourceId                String
  title                   String?
  link                    String?
  guid                    String?
  description             String?
  pubDate                 DateTime?
  dedupeKey               String
  mediaTopicQcodes        String[]            @default([])
  sentimentScore          Decimal?            @db.Decimal(5, 4)
  sentimentMatchedTerms   Int?
  sentimentLanguage       DictionaryLanguage?
  sentimentAnalyzedAt     DateTime?
  sentimentTerms          Json?
  capturedAt              DateTime            @default(now())
  source                  RssSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, dedupeKey])
  @@index([capturedAt])
  @@map("news")
}

enum DictionaryLanguage {
  es
  en
}

model DictionaryEntry {
  id       String             @id @default(uuid())
  term     String
  language DictionaryLanguage
  weight   Int

  @@unique([language, term])
  @@map("dictionary_entries")
}
